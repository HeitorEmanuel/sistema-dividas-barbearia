# Configuração local/online do sistema Riko Barbearia
# Copie estas variáveis para o ambiente do servidor quando for colocar online.

SECRET_KEY=troque-esta-chave-por-uma-chave-segura
DEBUG=False
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br

# Localmente você pode deixar DATABASE_URL vazio para usar SQLite.
# Online, use PostgreSQL:
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Alguns servidores exigem SSL no banco:
DB_SSL_REQUIRE=True

# Quando publicar, informe o endereço completo com https.
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
